---
/** The hero's install line, with a copy-to-clipboard button. */
const command = "npm install -g steerium";
---

<div class="lp-install">
  <span class="lp-prompt" aria-hidden="true">$</span>
  <code>{command}</code>
  <button class="lp-copy" type="button" data-command={command} aria-label={`Copy "${command}"`}>
    <svg
      class="lp-copy-idle"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
      <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
    </svg>
    <svg
      class="lp-copy-done"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M20 6 9 17l-5-5" />
    </svg>
    <span class="lp-sr" role="status"></span>
  </button>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(".lp-copy")) {
    const status = button.querySelector(".lp-sr");
    let reset: ReturnType<typeof setTimeout>;

    button.addEventListener("click", async () => {
      const command = button.dataset.command;
      if (!command) return;

      try {
        await navigator.clipboard.writeText(command);
      } catch {
        // No clipboard access (insecure context, or the user denied it). The
        // command is still plain selectable text, so just do nothing.
        return;
      }

      button.classList.add("is-copied");
      if (status) status.textContent = "Copied";

      clearTimeout(reset);
      reset = setTimeout(() => {
        button.classList.remove("is-copied");
        if (status) status.textContent = "";
      }, 1800);
    });
  }
</script>
